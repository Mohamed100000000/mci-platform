# Copy this file to .env.local and set the value before running or deploying the frontend.
#
# Base URL of the backend API (FastAPI service). Must NOT have a trailing slash.
# All frontend API clients (src/lib/api/client.ts, src/lib/api/auth.ts,
# src/lib/api/courses.ts, src/lib/api/trainees.ts, src/lib/api/mci.ts) read
# this single variable and append the backend's /api/v1 prefixed paths.
NEXT_PUBLIC_API_URL=https://mci-platform-production-3101.up.railway.app

# NOTE: src/lib/exam/examApi.ts uses a separate variable, NEXT_PUBLIC_API_BASE,
# because it targets the not-yet-wired /api/exam/* module (app/exam is not
# registered in app/routers/__init__.py on the backend yet). This is a known,
# intentional gap and is out of scope for the frontend<->backend integration
# fix. Do not set NEXT_PUBLIC_API_BASE to enable it without wiring the
# backend exam router first.
